# ---------------------------------------------------------------------------
# SynthOCT-Bibimbap .gitignore
# Repo tracks code, docs, paper source, and ONE lightweight example run.
# Raw data, generated outputs, scanner binaries, and build cruft stay local.
# ---------------------------------------------------------------------------

# --- Python / tooling cruft ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.DS_Store

# --- Raw data (download from Zenodo; see docs/DATA.md) ---
DATASET/
data/

# --- Scratch / temporary working dirs ---
tmp/
runs/
output/

# --- Secrets & credentials ---
secrets/
challenge_assets/
*.env
*.key

# --- Archives & binaries (never committed) ---
*.zip
*.tar
*.tar.gz
*.bundle
*.exe
*.bin
Part2_Scanner.exe
Scan_Raw.bin
Configuration.ini
Final_Metrics_Report.csv
314-SynthOCT_2026_Digital_Phantoms_Simulation_for_Physics-Based_Scans_2026-04-22T16-37-10.pdf

# --- Paper build artifacts (regenerated by make_figures.py + LaTeX) ---
paper/**/build/
paper/**/__pycache__/

# --- Generated outputs ---
# Ignore everything under outputs/ ...
outputs/*
# ... then keep ONE lightweight example run (small files only).
!outputs/holographic_inverse_contract300k/
outputs/holographic_inverse_contract300k/*
!outputs/holographic_inverse_contract300k/diagnostics.json
!outputs/holographic_inverse_contract300k/local.png
!outputs/holographic_inverse_contract300k/api_queue.csv
!outputs/holographic_inverse_contract300k/api/
# The 15 MB phantom.txt is intentionally excluded (regenerate via the CLI).
outputs/holographic_inverse_contract300k/phantom.txt
